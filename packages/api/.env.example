# API runtime mode
# false = always mock responses
# true = call Hugging Face first, fallback to mock on failure
PRODUCTION_MODE=false

# Required only when PRODUCTION_MODE=true
HUGGING_FACE_API_KEY=your_hf_token_here

# Model/provider selection (used when PRODUCTION_MODE=true)
HF_PROVIDER=together
HF_MODEL=
HF_ROUTER_BASE_URL=

