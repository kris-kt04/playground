{
  "name": "playground",
  "dockerComposeFile": ["./docker-compose.yml" ],
  "service": "devpod",
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "astro-build.astro-vscode",
        "ckolkman.vscode-postgres"
      ]
    }
  }
}